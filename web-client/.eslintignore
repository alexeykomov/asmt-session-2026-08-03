# Build output. public/main.min.js is ADVANCED-compiled — thousands of
# violations that mean nothing, and it is regenerated by every build.
public/

# Vendored Closure Templates runtime. Third-party source we neither wrote nor
# may reformat; changing it to satisfy our lint config would be overwriting a
# dependency in place.
third_party/

# Generated by scripts/compile-soy.js from ui-soy/*.soy, and git-ignored.
# The Soy compiler's output style is not ours to conform, and linting it made
# camelcase/no-var/quotes dominate the report while none of it was actionable.
src/templates/
