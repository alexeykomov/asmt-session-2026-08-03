# ── OS ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editors / IDEs ────────────────────────────────────────────────────
.idea/
*.iml
*.iws
.vscode/
.classpath
.project
.settings/
*.swp
*~

# ── Env files (never commit secrets) ──────────────────────────────────
.env
.env.local
.env.*.local
client_secret_*.json
*.pem
*.key

# ── Logs ──────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log*

# ── Node ──────────────────────────────────────────────────────────────
node_modules/
.npm/

# ── Go ────────────────────────────────────────────────────────────────
# Only ignore compiled binaries, NOT the bin/ dir itself — bin/dev.sh is source.
app-server/bin/server
app-server/bin/app-server
*.test
*.out
coverage.txt
coverage.html

# ── Generated proto code (regenerated by `make codegen`) ──────────────
api/gen/
# generate_js.sh symlinks node_modules in; keep that out too.
api/gen/js/node_modules

# ── Web client build outputs ──────────────────────────────────────────
web-client/public/*.js
web-client/public/*.js.map
web-client/public/*.css
web-client/css/*.min.css
# Generated from ui-soy/ by scripts/compile-soy.js — build output.
web-client/src/templates/

# ── Soy compile artifacts ─────────────────────────────────────────────
.soy-cache/
web-proxy/.soy-cache/
# soynode writes here at runtime
/tmp/soynode-funwithactivity/

# ── Docker / build ────────────────────────────────────────────────────
build/

# ── Claude Code runtime ───────────────────────────────────────────────
# .claude/settings.json IS tracked (shared deny rules etc.) — only ignore
# user-local overrides and runtime files.
.claude/scheduled_tasks.lock
.claude/settings.local.json
.claude/plans/
.claude/projects/

# ── Local plan/scratch docs ────────────────────────────────────────────
*-feature-parity-plan.md

# ── iOS / Xcode / CocoaPods ─────────────────────────────────────────────
xcuserdata/
apple-client/Pods/
apple-client/build/
DerivedData/
.claude/

# Xcode-generated per-user workspace state
apple-client/**/project.xcworkspace/
apple-client/**/xcuserdata/

# Generated from the git-ignored repo-root .env by
# apple-client/Config/generate-xcconfig.sh — can contain a real gRPC token.
apple-client/Config/Generated.xcconfig

# The Xcode project is generated in full by apple-client/generate_project.rb
# (Xcodeproj::Project.new — nothing in it is hand-maintained) and the
# workspace by `pod install`. Neither was ever a source file.
#
# They are ignored because generate_project.rb injects FWA_GRPC_TOKEN into
# GCC_PREPROCESSOR_DEFINITIONS, so a tracked pbxproj carries the real gRPC
# token into the repo — which is exactly what happened here: the token sat in
# 55 commits of a public repo before anyone noticed, having routed straight
# around Generated.xcconfig being ignored above.
#
# Regenerate with `make ios`, or `ruby generate_project.rb && pod install`.
apple-client/FunWithActivity.xcodeproj/
apple-client/FunWithActivity.xcworkspace/
