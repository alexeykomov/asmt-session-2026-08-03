# FunWithActivity — environment configuration
#
# Copy this file to `.env` (repo root) and fill in real values. `.env` is
# git-ignored — it never gets committed. This file is the one that ships in
# the public repo, so every value here is a safe placeholder.
#
# Consumers:
#   - app-server (Go)         reads PROVIDER1_URL / PROVIDER2_URL / INTERNAL_GRPC_TOKEN via os.Getenv
#   - web-proxy (Node)        reads INTERNAL_GRPC_TOKEN / APP_SERVER_URL via process.env
#   - deploy/docker-compose.yml  loads this whole file via `env_file: .env`
#   - web-server/provision.sh    sources this file for the droplet deploy
#   - deploy/app-platform.yaml   has no .env support — same keys are set by hand
#                                 in the DO App Platform dashboard instead
#   - android-client/app/build.gradle  loads GRPC_HOST / (optionally) INTERNAL_GRPC_TOKEN
#                                        from this file into Gradle properties
#   - apple-client                     apple-client/Config/generate-xcconfig.sh turns
#                                        GRPC_HOST into an Xcode preprocessor define

# Vendor Service 1 endpoint (full URL, including the /services/service1
# path). Get the real value from the presale/integration team's delivery —
# see docs/integrations/service1.md for the wire contract.
PROVIDER1_URL=https://example.invalid/services/service1

# Vendor Service 2 endpoint (full URL, including the /services/service2
# path). Same deployment as PROVIDER1_URL, different route — see
# docs/integrations/service2.md.
PROVIDER2_URL=https://example.invalid/services/service2

# Shared bearer secret between app-server and its gRPC clients (web-proxy,
# iOS, Android). Generate one with `openssl rand -hex 24`; there is no
# "correct" value to look up — pick a fresh one per environment and put the
# same value on every client that must authenticate against that app-server.
INTERNAL_GRPC_TOKEN=changeme-generate-with-openssl-rand-hex-24

# host:port the mobile clients (iOS + Android) dial for the RecommendationsService
# gRPC endpoint. Use your local app-server (e.g. localhost:50051, or
# 10.0.2.2:50051 from the Android emulator) for development, or the deployed
# edge's public host:port (see web-server/provision.sh) for a real demo build.
GRPC_HOST=localhost:50051

# Public URL of the deployed web app (DigitalOcean App Platform hostname, or
# your own domain once one is attached). Used in docs/demo-script.md's
# warm-up curl commands — not read by any service at runtime.
WEB_APP_URL=https://example.invalid
