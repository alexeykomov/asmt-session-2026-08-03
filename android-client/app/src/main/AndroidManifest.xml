<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- androidx.health.connect:connect-client declares minSdk 26; the app's
         own minSdk stays 24 per house convention. HealthConnectHelper guards
         every entry point with HealthConnectClient.getSdkStatus() (itself
         wrapped defensively) and always falls back to manual entry, so
         forcing the lower minSdk here is safe: pre-26 devices simply never
         take the Health Connect path. -->
    <uses-sdk tools:overrideLibrary="androidx.health.connect.client" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Health Connect (M5): read-only access to height, weight, birth date
         to prefill the measurement form. See HealthConnectHelper for the
         manual-entry fallback used when permission is denied or Health
         Connect is not installed. -->
    <uses-permission android:name="android.permission.health.READ_HEIGHT" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
    </queries>

    <application
        android:name=".FunWithActivityApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FunWithActivity"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- LAUNCHER: three-tab shell (Recommendations / Sources / Profile)
             behind a BottomNavigationView — see MainActivity. -->
        <activity android:name=".features.app.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FunWithActivity.NoActionBar"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Source detail screen (Sources tab row tap) — same grouped-card
             style as Profile, pushed as its own Activity so system/gesture
             back just finishes it. -->
        <activity android:name=".features.sources.SourceDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.FunWithActivity.NoActionBar"
            android:parentActivityName=".features.app.MainActivity" />

        <!-- Health Connect permission-rationale entry point. Health Connect's
             permissions screen links back here; routes to the tabbed shell,
             which surfaces the same manual-entry fallback via Profile. -->
        <activity-alias
            android:name=".PermissionsRationaleActivity"
            android:exported="true"
            android:targetActivity=".features.app.MainActivity">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity-alias>

        <property
            android:name="android.health_connect.PERMISSIONS"
            android:resource="@array/health_permissions" />

    </application>

</manifest>
