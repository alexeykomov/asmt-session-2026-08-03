<?xml version="1.0" encoding="utf-8"?>
<!--
  Trends tab. The charts themselves are inflated into `charts_container` at
  runtime by ChartsFragment: the number of charts and the number of series in
  each come from the server, so there is nothing static to declare here.

  SwipeRefreshLayout matches the Recommendations tab's pull-to-refresh, which
  is the only manual refresh path on either screen.
-->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/charts_swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/charts_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp" />

    </ScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
