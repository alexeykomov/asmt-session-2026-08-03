<?xml version="1.0" encoding="utf-8"?>
<!--
  One contributing provider inside the PROVENANCE card of
  activity_recommendation_detail.xml. Inflated once per provider named in
  the recommendation's joined source string, since that count varies.

  Same label-left / value-right shape as the static rows in
  activity_source_detail.xml, so the two detail screens match.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/provenance_row_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBody1" />

    <TextView
        android:id="@+id/provenance_row_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="end"
        android:textAppearance="?attr/textAppearanceBody1" />

</LinearLayout>
