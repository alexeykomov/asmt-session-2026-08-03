<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ProgressBar
        android:id="@+id/recs_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="32dp" />

    <TextView
        android:id="@+id/recs_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:textColor="@color/colorStatusDegradedText"
        android:visibility="gone" />

    <!-- Status/banner area: one row per ProviderStatus, rendered per the
         ok / skipped / error branching resolved by ProviderStatusPresentation.
         Populated dynamically since the number of providers is server-driven. -->
    <LinearLayout
        android:id="@+id/recs_status_banner_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/recs_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:gravity="center"
        android:text="@string/empty_results"
        android:visibility="gone" />

    <!-- Standard Android reload gesture, matching iOS's UIRefreshControl
         (FWARecommendationsViewController.m) — parity across clients. This
         is the ONLY manual refresh affordance on this screen: no toolbar
         action, no FAB (the FAB is reserved for Sources' "+"). Calls
         loadRecommendations(), the same force-refresh path the dirty-driven
         auto-refetch uses. -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/recs_swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recs_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="8dp" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
