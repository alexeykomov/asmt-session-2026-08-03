         truncates on a narrow screen, so the tab says "Recs" while the
         screen itself keeps the full word. -->
    <string name="tab_recommendations">Recs</string>
    <string name="tab_sources">Sources</string>
    <string name="tab_profile">Profile</string>

    <!-- Measurements (Profile > MEASUREMENTS, also used by Health Connect prefill) -->
    <string name="label_height_cm">Height (cm)</string>
    <string name="label_weight_kg">Weight (kg)</string>
    <string name="label_birth_date">Date of birth (optional)</string>
    <string name="birth_date_hint">Not supplied</string>
    <string name="clear_birth_date">Clear</string>
    <string name="health_connect_prefill">Prefill from Health Connect</string>
    <string name="health_connect_unavailable">Health Connect is not available on this device — enter your measurements manually.</string>
    <string name="health_connect_permission_denied">Health Connect access was declined — enter your measurements manually.</string>
    <string name="health_connect_no_data">No height/weight recorded in Health Connect yet — enter your measurements manually.</string>
    <string name="health_connect_prefilled">Prefilled from Health Connect.</string>

    <!-- Recommendations tab -->
    <string name="loading">Loading recommendations…</string>
    <string name="empty_results">No recommendations returned.</string>
    <string name="request_failed">Request failed: %1$s</string>
    <string name="score_format">Score: %1$.2f</string>
    <string name="status_skipped_format">%1$s skipped — %2$s</string>
    <string name="status_error_format">%1$s unavailable — showing partial results (%2$s)</string>
    <string name="status_ok_format">%1$s: %2$s in %3$d ms</string>

    <!-- Zero-recommendations banner wording (task-empty-state-copy). Only
         used when getRecommendationsList() is empty, so the per-provider
         "showing partial results" claim above would be false. Does not
         re-derive skipped-vs-degraded — ProviderStatusPresentation still
         does that; these only cover how zero results get worded/grouped.
         status_all_failed/status_all_skipped replace the whole per-provider
         list with one summary banner (red / blue respectively — skipped
         stays blue, it is a data-minimisation outcome, never a failure).
         status_error_format_no_partial is used instead of status_error_format
         in the mixed skipped+failed case, to say both plainly without
         claiming partial results. -->
    <string name="status_all_failed">No recommendations available — all providers are unavailable</string>
    <string name="status_all_skipped">No recommendations — no provider had the data it needs</string>
    <string name="status_error_format_no_partial">%1$s unavailable (%2$s)</string>

    <!-- Pluralised recommendation count for the OK status banner
         (status_ok_format's %2$s) — avoids the "recommendation(s)"
         placeholder-ism. -->
    <plurals name="recommendation_count">
        <item quantity="one">%d recommendation</item>
        <item quantity="other">%d recommendations</item>
    </plurals>

    <!-- Sources tab -->
    <string name="sources_empty">No source data yet — visit Recommendations first.</string>
    <string name="source_status_ok">ok</string>
    <string name="source_status_skipped">skipped</string>
    <string name="source_status_degraded">degraded</string>
    <string name="source_latency_format">Latency: %1$s</string>
    <string name="source_latency_dash">—</string>
    <string name="source_latency_ms_format">%1$d ms</string>
    <string name="action_add_source">Add source</string>

    <!-- Sources list: short reasons only (design spec addendum — the full
         provider error embeds the vendor's Lambda URL and must never be
         projected in the list; the full text still appears on the source
         detail screen's STATUS section). -->
    <string name="source_reason_skipped_no_birth_date">skipped — no birth date</string>
    <string name="source_reason_timed_out">timed out</string>
    <string name="source_reason_unavailable">unavailable</string>

    <!-- Source detail screen: same grouped-card style as Profile. The two
