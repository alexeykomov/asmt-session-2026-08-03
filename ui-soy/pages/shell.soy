{namespace funwithactivity.pages.shell}

/**
 * Application shell: a three-tab header and a single mount element the
 * active screen component renders into. Screens are mounted by
 * funwithactivity.app.Shell, not by this template.
 */
{template .page}
  {call funwithactivity.layout.base.render}
    {param content kind="html"}
      {call .body /}
    {/param}
  {/call}
{/template}

{template .body}
  /*
   * Empty on purpose: funwithactivity.app.Shell#buildTabBar_ renders a
   * real goog.ui.TabBar (goog.ui.Tab children) into this mount element
   * rather than decorating hand-authored anchors — see that method's doc
   * for why decoration was rejected in favor of programmatic construction.
   */
  <div id="fwa-tabs" class="fwa-tabbar-mount"></div>
  /*
   * A div, not a <main>: base.soy already wraps page content in
   * <main id="main-content">. Nesting a second <main> is invalid HTML and
   * gives assistive technology two competing top-level landmarks.
   */
  <div id="screen" class="fwa-screen"></div>
{/template}
