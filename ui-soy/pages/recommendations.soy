{namespace funwithactivity.pages.recommendations}

/**
 * Interactive recommendations page. First render ships with an empty
 * recommendations list — the form drives subsequent XHR calls to
 * POST /api/recommendations, so no upstream call is needed on GET /.
 */
{template .page}
  {@param recommendations: list<?>}
  {call funwithactivity.layout.base.render}
    {param content kind="html"}
      {call .body}
        {param recommendations: $recommendations /}
      {/call}
    {/param}
  {/call}
{/template}

{template .body}
  {@param recommendations: list<?>}
  <section class="recs-section">
    <form id="recs-form" class="recs-form" novalidate>
      <fieldset>
        <legend>Measurements</legend>
        <div class="recs-field">
          <label for="height-cm">Height (cm)</label>
          <input type="number" id="height-cm" name="heightCm" min="1" step="0.1" required>
        </div>
        <div class="recs-field">
          <label for="weight-kg">Weight (kg)</label>
          <input type="number" id="weight-kg" name="weightKg" min="1" step="0.1" required>
        </div>
        <div class="recs-field">
          <label for="birth-date">Birth date <span class="recs-optional">(optional)</span></label>
          <input type="date" id="birth-date" name="birthDate">
        </div>
      </fieldset>

      <fieldset>
        <legend>Fault injection (demo)</legend>
        <div class="recs-fault-row">
          <input type="checkbox" id="fault-service1" name="faultService1">
          <label for="fault-service1">Service 1</label>
          <select id="fault-service1-mode" name="faultService1Mode" disabled>
            <option value="error">error</option>
            <option value="timeout">timeout</option>
            <option value="malformed">malformed</option>
          </select>
        </div>
        <div class="recs-fault-row">
          <input type="checkbox" id="fault-service2" name="faultService2">
          <label for="fault-service2">Service 2</label>
          <select id="fault-service2-mode" name="faultService2Mode" disabled>
            <option value="error">error</option>
            <option value="timeout">timeout</option>
            <option value="malformed">malformed</option>
          </select>
        </div>
      </fieldset>

      <button type="submit" id="recs-submit" class="recs-submit">Get recommendations</button>
    </form>

    <div id="degradation-banner" role="alert"></div>

    <div id="recs-table-mount">
      {call funwithactivity.components.recommendationsTable.table}
        {param recommendations: $recommendations /}
      {/call}
    </div>
  </section>
{/template}
