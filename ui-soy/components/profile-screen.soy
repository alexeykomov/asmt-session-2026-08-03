{namespace funwithactivity.components.profileScreen}

/**
 * Static structure for the Profile screen: a shared screen header (title
 * only — Profile has no primary action) plus two settings-table style
 * sections (MEASUREMENTS, DEVELOPER), each row carrying a stable id.
 * funwithactivity.profile.ProfileComponent decorates these ids with
 * goog.ui widgets in enterDocument() rather than generating markup in
 * JS, matching the decorate convention the rest of this codebase uses
 * (funwithactivity.recs.RecsComponent#attachTableSorter_ decorates the
 * table the same way).
 *
 * The two sections are rendered via funwithactivity.components.
 * screenSection.section — this screen is where that group/header look
 * originated, and it is now extracted there rather than hand-authored
 * here, so Sources and Recommendations can reuse the exact same markup.
 *
 * Height/weight stay native <input type="number"> — see the doc on
 * ProfileComponent for why. The birth date input is decorated by a
 * goog.ui.InputDatePicker; the adjacent button is a goog.ui.Button that
 * clears it in one click, independent of whether the calendar popup is
 * even open — that is the one-gesture data-minimisation demo beat.
 *
 * The fault rows only provide a checkbox-decoration target
 * (`fault-<provider>`) and an empty mount div for the mode
 * goog.ui.Select (`fault-<provider>-mode`) — ProfileComponent builds
 * the Select's goog.ui.Menu/goog.ui.MenuItem tree in JS and renders it
 * into that mount rather than decorating hand-authored menu markup:
 * goog.ui.MenuButtonRenderer's decorate() path expects an exact nested
 * .goog-menu/.goog-menuitem DOM shape, and getting that wrong by hand
 * reproduces the "present in the DOM but invisible" failure mode this
 * task exists to avoid. The checkbox and date input, by contrast, each
 * decorate a single existing element with a well-defined shape, so
 * those are still authored here and decorated in place.
 */
{template .screen}
  <section class="profile-section">
    {call funwithactivity.components.screenHeader.header}
      {param title: 'Profile' /}
    {/call}

    {call funwithactivity.components.screenSection.section}
      {param heading: 'Measurements' /}
      {param content kind="html"}
        <div class="settings-row">
          <label class="settings-label" for="profile-height">Height (cm)</label>
          <div class="settings-control">
            <input type="number" id="profile-height" class="settings-number-input" min="0" step="0.1">
          </div>
        </div>

        <div class="settings-row">
          <label class="settings-label" for="profile-weight">Weight (kg)</label>
          <div class="settings-control">
            <input type="number" id="profile-weight" class="settings-number-input" min="0" step="0.1">
          </div>
        </div>

        <div class="settings-row">
          <label class="settings-label" for="profile-birth-date">Birth date</label>
          <div class="settings-control settings-control-birth-date">
            <input type="text" id="profile-birth-date" class="settings-date-input" placeholder="yyyy-mm-dd" autocomplete="off">
            <button type="button" id="profile-birth-date-clear">Clear</button>
          </div>
        </div>
      {/param}
    {/call}

    {call funwithactivity.components.screenSection.section}
      {param heading: 'Developer' /}
      {param content kind="html"}
        <div class="settings-row">
          <span class="settings-label">Service 1 fault</span>
          <div class="settings-control settings-control-fault">
            <span id="fault-service1"></span>
            <div id="fault-service1-mode" class="settings-select-mount"></div>
          </div>
        </div>

        <div class="settings-row">
          <span class="settings-label">Service 2 fault</span>
          <div class="settings-control settings-control-fault">
            <span id="fault-service2"></span>
            <div id="fault-service2-mode" class="settings-select-mount"></div>
          </div>
        </div>
      {/param}
    {/call}
  </section>
{/template}
