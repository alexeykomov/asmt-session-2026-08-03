{namespace funwithactivity.components.sourcesScreen}

/**
 * Sources screen: one row per provider from the most recent
 * POST /api/recommendations response's `statuses[]`
 * (funwithactivity.app.LastStatuses), each linking to `/sources/<name>`
 * for the read-only detail screen.
 *
 * The list NEVER prints `status.error` verbatim — that raw text can embed
 * a full vendor URL (see funwithactivity.features.recommendations.
 * shortReason's doc). Only classify()'s status pill and shortReason()'s
 * short phrase render here; the full text is reserved for the Source
 * detail screen's STATUS section, where an operator needs it.
 *
 * `.screen` renders the static shell — the shared screen header (title +
 * the `+` button's decoration target) and, inside a shared
 * funwithactivity.components.screenSection group (heading "Sources", the
 * same grouped-rows chrome Profile uses), the list mount.
 * funwithactivity.sources.SourcesComponent populates `#sources-list-mount`
 * via `.list` after every fetch/cache read, mirroring the recs-screen.soy
 * / recommendations-table.soy split (static shell template + separate
 * data-driven template re-rendered into a mount element).
 */
{template .screen}
  <section class="sources-section">
    {call funwithactivity.components.screenHeader.header}
      {param title: 'Sources' /}
      {param actionId: 'sources-add' /}
      {param actionLabel: '+' /}
      {param actionTitle: 'Add source' /}
      {param actionIcon: true /}
    {/call}

    {call funwithactivity.components.screenSection.section}
      {param heading: 'Sources' /}
      {param content kind="html"}
        <div id="sources-list-mount">Loading source status…</div>
      {/param}
    {/call}
  </section>
{/template}

/**
 * Data-driven rows. Each entry in `$rows` is built by
 * funwithactivity.sources.SourcesComponent#toRow_ from a
 * funwithactivity.dto.ProviderStatus — see that method for the exact
 * shape (name, href, statusClass, statusLabel, reason, latencyDisplay).
 *
 * Every row here is a real `<a href>` to `/sources/<name>` (the source
 * detail screen), so each one carries a trailing `.sources-row-chevron`
 * disclosure glyph — muted, decorative (`aria-hidden`, since the row's own
 * link semantics already say "navigates" to assistive tech), matching the
 * disclosure indicator iOS and Android already show on these same rows.
 * That chevron is reserved for genuinely navigable rows: the source
 * detail screen's own CONFIGURATION/STATUS rows
 * (source-detail-screen.soy) and every Profile row are plain, read-only
 * or in-place-editable, and must never get one.
 */
{template .list}
  {@param rows: list<?>}
  {if length($rows) == 0}
    <p class="sources-empty">No sources reported yet.</p>
  {else}
    {foreach $row in $rows}
      <a class="sources-row" href="{$row.href}">
        <span class="sources-row-name">{$row.name}</span>
        <span class="status-pill status-pill-{$row.statusClass}">{$row.statusLabel}</span>
        <span class="sources-row-reason">{$row.reason ?: ''}</span>
        <span class="sources-row-latency">{$row.latencyDisplay}</span>
        <span class="sources-row-chevron" aria-hidden="true">›</span>
      </a>
    {/foreach}
  {/if}
{/template}
