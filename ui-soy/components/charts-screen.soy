{namespace funwithactivity.components.chartsScreen}

/**
 * Static structure for the Charts screen: the shared screen header (title +
 * Refresh, laid out identically to Recommendations and Sources), a mount the
 * charts are drawn into, and the sample-data footer.
 *
 * Rendered exactly once by funwithactivity.charts.ChartsComponent#createDom;
 * `#charts-mount` is then rewritten in place on every fetch or repaint, so
 * the empty-state paragraph below is only what shows between mount and the
 * first paint.
 *
 * The data is generated server-side rather than measured — see
 * app-server/internal/charts. That was previously stated in an on-screen
 * footer; the footer was removed by review decision on all three clients, so
 * the fact now lives in the code and the spec rather than in the UI.
 */
{template .screen}
  <section class="charts-section">
    {call funwithactivity.components.screenHeader.header}
      {param title: 'Trends' /}
      {param actionId: 'charts-refresh' /}
      {param actionLabel: 'Refresh' /}
    {/call}

    <div id="charts-banner" role="alert"></div>

    <div id="charts-mount">
      <p class="chart-empty">Loading charts…</p>
    </div>
  </section>
{/template}
