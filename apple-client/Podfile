# Podfile for FunWithActivity iOS Client

platform :ios, '15.0'

def shared_pods
  pod 'gRPC-ProtoRPC', '~> 1.76'
  pod 'Protobuf', '~> 4.28'
end

target 'FunWithActivityCore' do
  use_frameworks!
  shared_pods
end

target 'FunWithActivity' do
  use_frameworks!
  shared_pods
end

target 'FunWithActivityCoreTests' do
  use_frameworks!
  # -ObjC force-loads every class in FunWithActivityCore, including the
  # networking classes, so this needs the full shared_pods set (not just
  # Protobuf) even though the tests only exercise
  # FWAProviderStatusPresentation directly.
  shared_pods
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      # Fix gRPC/BoringSSL/abseil C++17 compatibility with modern Xcode.
      config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
    end
  end
end
